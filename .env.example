# ============================================
# AL SAEED PLATFORM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values
# ============================================

# ---------- DATABASE ----------
# Local Postgres OR Supabase connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/alsaeed?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/alsaeed?schema=public"

# ---------- SUPABASE (if used as DB + Auth + Storage) ----------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-NEVER-EXPOSE"

# ---------- BACKEND API ----------
API_PORT=4000
API_BASE_URL="http://localhost:4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ---------- FRONTEND ----------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Al Saeed ETC"

# ---------- AUTHENTICATION ----------
JWT_ACCESS_SECRET="change-this-to-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# ---------- GOOGLE OAUTH ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"

# ---------- EMAIL (for OTP, verification, password reset) ----------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Al Saeed ETC <noreply@alsaeed-etc.com>"

# ---------- AI / OPENAI ----------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Optional: Anthropic Claude as alternative
ANTHROPIC_API_KEY=""

# ---------- STORAGE ----------
# Option A: Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Option B: AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ---------- PAYMENTS ----------
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Paymob (Egypt / MENA)
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""

# ---------- REDIS (for sessions, rate-limit, queues) ----------
REDIS_URL="redis://localhost:6379"

# ---------- MONITORING (optional but recommended) ----------
SENTRY_DSN=""
LOG_LEVEL="info"

# ---------- RATE LIMITING ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
