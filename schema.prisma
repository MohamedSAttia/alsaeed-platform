// ============================================
// AL SAEED PLATFORM - DATABASE SCHEMA
// Built for: LMS + AI + Consulting + Corporate + Payments
// Database: PostgreSQL (works with Supabase too)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT
  CORPORATE_ADMIN
  CORPORATE_LEARNER
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  firstName       String
  lastName        String
  phone           String?      @unique
  avatarUrl       String?
  role            UserRole     @default(STUDENT)
  authProvider    AuthProvider @default(EMAIL)
  emailVerified   Boolean      @default(false)
  phoneVerified   Boolean      @default(false)
  isActive        Boolean      @default(true)
  preferredLang   String       @default("ar")
  timezone        String       @default("Africa/Cairo")
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  sessions          Session[]
  otpCodes          OtpCode[]
  enrollments       Enrollment[]
  progress          LessonProgress[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  payments          Payment[]
  subscriptions     Subscription[]
  consultations     ConsultationRequest[]
  notes             LessonNote[]
  favorites         LibraryFavorite[]
  aiConversations   AiConversation[]
  reviews           CourseReview[]
  authoredCourses   Course[]              @relation("CourseInstructor")
  corporateMember   CorporateMember?
  permissions       UserPermission[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ============================================
// RBAC - PERMISSIONS
// ============================================

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "course.create", "user.delete"
  description String?
  createdAt   DateTime @default(now())

  users UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId       String
  permissionId String
  grantedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ============================================
// LMS - COURSES, CHAPTERS, LESSONS
// ============================================

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameAr      String
  nameEn      String
  iconUrl     String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  courses  Course[]

  @@map("categories")
}

model Course {
  id              String       @id @default(cuid())
  slug            String       @unique
  titleAr         String
  titleEn         String
  descriptionAr   String?      @db.Text
  descriptionEn   String?      @db.Text
  thumbnailUrl    String?
  trailerVideoUrl String?
  level           CourseLevel  @default(BEGINNER)
  status          CourseStatus @default(DRAFT)
  language        String       @default("ar")
  durationMinutes Int          @default(0)
  price           Decimal      @default(0) @db.Decimal(10, 2)
  discountPrice   Decimal?     @db.Decimal(10, 2)
  currency        String       @default("USD")
  isFeatured      Boolean      @default(false)
  rating          Float        @default(0)
  enrollmentCount Int          @default(0)

  categoryId   String
  instructorId String
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id])
  instructor  User           @relation("CourseInstructor", fields: [instructorId], references: [id])
  chapters    Chapter[]
  enrollments Enrollment[]
  reviews     CourseReview[]
  certificates Certificate[]
  quizzes     Quiz[]

  @@index([slug])
  @@index([status, isFeatured])
  @@index([categoryId])
  @@map("courses")
}

model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  titleAr   String
  titleEn   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("chapters")
}

enum LessonType {
  VIDEO
  PDF
  TEXT
  LIVE
  QUIZ
  ASSIGNMENT
}

model Lesson {
  id              String     @id @default(cuid())
  chapterId       String
  titleAr         String
  titleEn         String
  type            LessonType @default(VIDEO)
  contentUrl      String?
  contentText     String?    @db.Text
  durationSeconds Int        @default(0)
  isFreePreview   Boolean    @default(false)
  sortOrder       Int        @default(0)
  aiSummary       String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  chapter     Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attachments LessonAttachment[]
  progress    LessonProgress[]
  notes       LessonNote[]

  @@index([chapterId])
  @@map("lessons")
}

model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_attachments")
}

model LessonNote {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  content         String   @db.Text
  videoTimestamp  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@map("lesson_notes")
}

// ============================================
// ENROLLMENT & PROGRESS
// ============================================

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  progressPct Float            @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@map("enrollments")
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  watchedSeconds  Int       @default(0)
  lastPosition    Int       @default(0)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ============================================
// QUIZ & SIMULATION ENGINE
// ============================================

enum QuizType {
  PRACTICE
  EXAM
  SIMULATION
  PMP
  PMI_RMP
  PMI_ACP
  GRCP
  ITGRC
  NEBOSH
  HR_CERT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Quiz {
  id                String   @id @default(cuid())
  courseId          String?
  titleAr           String
  titleEn           String
  type              QuizType @default(PRACTICE)
  durationMinutes   Int      @default(60)
  passingScore      Int      @default(70)
  questionCount     Int      @default(0)
  randomizeOrder    Boolean  @default(true)
  showExplanations  Boolean  @default(true)
  maxAttempts       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course    Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType @default(SINGLE_CHOICE)
  domain        String?      // for PMP/PMI domain analytics
  textAr        String       @db.Text
  textEn        String       @db.Text
  explanationAr String?      @db.Text
  explanationEn String?      @db.Text
  difficulty    Int          @default(2) // 1-5
  createdAt     DateTime     @default(now())

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers QuizAnswer[]

  @@index([quizId, domain])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  textAr     String
  textEn     String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@map("question_options")
}

model QuizAttempt {
  id           String    @id @default(cuid())
  userId       String
  quizId       String
  score        Float?
  passed       Boolean?
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  timeSpentSec Int       @default(0)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  optionId    String?
  textAnswer  String?
  isCorrect   Boolean?

  attempt  QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id])
  option   QuestionOption? @relation(fields: [optionId], references: [id])

  @@map("quiz_answers")
}

// ============================================
// CERTIFICATES
// ============================================

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  courseId      String?
  certNumber    String   @unique
  templateId    String?
  pdfUrl        String?
  qrVerifyUrl   String?
  language      String   @default("ar")
  issuedAt      DateTime @default(now())
  expiresAt     DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([certNumber])
  @@map("certificates")
}

// ============================================
// LIBRARY
// ============================================

enum LibraryItemType {
  BOOK
  PDF
  TEMPLATE
  RESEARCH
  VIDEO
  AUDIO
}

model LibraryItem {
  id            String          @id @default(cuid())
  type          LibraryItemType
  titleAr       String
  titleEn       String
  descriptionAr String?         @db.Text
  descriptionEn String?         @db.Text
  fileUrl       String
  thumbnailUrl  String?
  fileSize      Int             @default(0)
  language      String          @default("ar")
  isPremium     Boolean         @default(false)
  downloadCount Int             @default(0)
  createdAt     DateTime        @default(now())

  favorites LibraryFavorite[]

  @@index([type])
  @@map("library_items")
}

model LibraryFavorite {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("library_favorites")
}

// ============================================
// REVIEWS
// ============================================

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_reviews")
}

// ============================================
// CORPORATE / B2B
// ============================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?
  industry     String?
  size         String?  // "1-10", "11-50", etc.
  country      String?
  taxNumber    String?
  contactEmail String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  members       CorporateMember[]
  subscriptions Subscription[]

  @@map("organizations")
}

enum CorporateRole {
  ADMIN
  MANAGER
  LEARNER
}

model CorporateMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String        @unique
  role           CorporateRole @default(LEARNER)
  department     String?
  jobTitle       String?
  joinedAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("corporate_members")
}

// ============================================
// CONSULTING
// ============================================

enum ConsultationStatus {
  PENDING
  REVIEWING
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ConsultationRequest {
  id            String             @id @default(cuid())
  userId        String
  serviceType   String
  subject       String
  details       String             @db.Text
  status        ConsultationStatus @default(PENDING)
  scheduledAt   DateTime?
  meetingUrl    String?
  attachmentUrls String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("consultation_requests")
}

// ============================================
// PAYMENTS & SUBSCRIPTIONS
// ============================================

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYMOB
  APPLE_PAY
  MANUAL
}

model Payment {
  id              String          @id @default(cuid())
  userId          String
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  status          PaymentStatus   @default(PENDING)
  provider        PaymentProvider
  providerRef     String?         @unique
  description     String?
  metadata        Json?
  invoiceUrl      String?
  refundedAmount  Decimal?        @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  subscription Subscription?

  @@index([userId, status])
  @@map("payments")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
}

enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

model Plan {
  id              String               @id @default(cuid())
  slug            String               @unique
  nameAr          String
  nameEn          String
  descriptionAr   String?              @db.Text
  descriptionEn   String?              @db.Text
  price           Decimal              @db.Decimal(10, 2)
  currency        String               @default("USD")
  interval        SubscriptionInterval @default(MONTHLY)
  features        Json                 // array of feature keys
  maxUsers        Int                  @default(1)
  isActive        Boolean              @default(true)
  isPopular       Boolean              @default(false)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  organizationId  String?
  planId          String
  paymentId       String?            @unique
  status          SubscriptionStatus @default(ACTIVE)
  startsAt        DateTime           @default(now())
  endsAt          DateTime
  autoRenew       Boolean            @default(true)
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  plan         Plan          @relation(fields: [planId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  discountType String   // "PERCENT" or "FIXED"
  discountValue Decimal @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int      @default(0)
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("coupons")
}

// ============================================
// AI SYSTEM
// ============================================

enum AiConversationKind {
  GENERAL
  TUTOR
  CAREER
  LESSON_HELPER
  QUIZ_EXPLAINER
}

model AiConversation {
  id        String             @id @default(cuid())
  userId    String
  kind      AiConversationKind @default(GENERAL)
  title     String?
  context   Json?              // optional: lessonId, courseId, etc.
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiMessage {
  id              String        @id @default(cuid())
  conversationId  String
  role            AiMessageRole
  content         String        @db.Text
  tokensUsed      Int?
  modelUsed       String?
  createdAt       DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  COURSE_UPDATE
  PAYMENT
  CERTIFICATE
  CONSULTATION
  SYSTEM
  PROMOTIONAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleAr   String
  titleEn   String
  bodyAr    String           @db.Text
  bodyEn    String           @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ============================================
// AUDIT LOG (for security & compliance)
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "user.login", "course.create", etc.
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
